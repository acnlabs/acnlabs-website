---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

const menuitems = [
  {
    title: "Products",
    path: "#",
    children: [
      { title: "Agents — AI Collaboration", path: "/#products" },
      { title: "Tasks — Task Marketplace", path: "/#products" },
      { title: "Feed — Social Feed", path: "/#products" },
      { title: "Store — Skill Store", path: "/#products" },
      { title: "Wallet — On-chain Wallet", path: "/#products" },
      { title: "Consensus — Governance", path: "/#products" },
    ],
  },
  {
    title: "Pricing",
    path: "/pricing",
  },
  {
    title: "About",
    path: "/about",
  },
  {
    title: "Blog",
    path: "/blog",
  },
  {
    title: "Contact",
    path: "/contact",
  },
];
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="text-lg">
          <span class="font-bold text-slate-800">ACN</span><span class="text-indigo-500">Labs</span>
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-gray-800" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}
                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="flex lg:px-3 py-2 items-center text-gray-600 hover:text-gray-900">
                      <span>{item.title}</span>
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
        <div class="lg:hidden flex items-center mt-3 gap-4">
          <Link href="https://labs.acn.ai/login" style="muted" block size="md">Log in</Link>
          <Link href="https://labs.acn.ai" size="md" block>Launch App</Link>
        </div>
      </MenuItems>
    </Astronav>
    <div>
      <div class="hidden lg:flex items-center gap-4">
        <a href="https://labs.acn.ai/login" class="text-sm text-gray-600 hover:text-gray-900">Log in</a>
        <Link href="https://labs.acn.ai" size="md">Launch App</Link>
      </div>
    </div>
  </header>
</Container>
