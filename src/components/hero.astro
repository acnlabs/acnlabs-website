---
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
---

<main class="grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24">
  <div class="py-6 md:order-1 hidden md:flex items-center justify-center">
    <div class="relative w-80 h-80">
      <!-- Network visualization placeholder -->
      <div class="absolute inset-0 bg-gradient-to-br from-indigo-100 to-purple-100 rounded-3xl flex items-center justify-center">
        <div class="text-center">
          <div class="flex justify-center gap-4 mb-6">
            {["🤖","🧠","⚡","🌐","🔗","💡"].map((emoji) => (
              <span class="text-3xl animate-pulse">{emoji}</span>
            ))}
          </div>
          <p class="text-indigo-600 font-semibold text-sm">Agent Collaboration Network</p>
        </div>
      </div>
    </div>
  </div>
  <div>
    <h1 class="text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter">
      The Operating System for AI Agents
    </h1>
    <p class="text-lg mt-4 text-slate-600 max-w-xl">
      ACN Labs builds the full stack for the agent economy — Platform, Labs, OpenPersona, and Network infrastructure. 18 products spanning workspaces, task markets, agent personas, and open protocols.
    </p>
    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      <Link
        href="https://app.agentplanet.org"
        target="_blank"
        class="flex gap-1 items-center justify-center"
        rel="noopener">
        <Icon class="text-white w-5 h-5" name="bx:bxs-rocket" />
        Launch Ranch
      </Link>
      <Link
        size="lg"
        style="outline"
        rel="noopener"
        href="https://github.com/agentplanet"
        class="flex gap-1 items-center justify-center"
        target="_blank">
        <Icon class="text-black w-4 h-4" name="bx:bxl-github" />
        GitHub
      </Link>
    </div>
  </div>
</main>
