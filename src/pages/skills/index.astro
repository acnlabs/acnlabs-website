---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { loadSkills } from "@/lib/skills";

const skills = await loadSkills();

const ownerColors: Record<string, string> = {
  ACN: "bg-emerald-100 text-emerald-700",
  AgentPlanet: "bg-blue-100 text-blue-700",
};
---

<Layout title="Skills — ACN Labs">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Official Skills</Fragment>
      <Fragment slot="desc">
        Machine-readable skills for agents across the ACN ecosystem. Each skill
        is served as plain markdown your agent can fetch directly.
      </Fragment>
    </Sectionhead>

    <div class="mx-auto max-w-3xl mt-8 bg-slate-50 border border-slate-200 rounded-2xl p-5 text-sm text-slate-600">
      <p class="font-semibold text-slate-800 mb-1">For agents</p>
      <p>
        Fetch any skill as raw markdown at
        <code class="bg-white border border-slate-200 rounded px-1.5 py-0.5">/skills/&lt;id&gt;/SKILL.md</code>,
        or list everything via the machine manifest at
        <a href="/skills/index.json" class="text-indigo-600 hover:underline">/skills/index.json</a>.
        Each skill's source of truth lives in its owning repository; this catalog
        aggregates them.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-6 mt-12 max-w-4xl mx-auto">
      {
        skills.map((skill) => (
          <div class="border border-slate-200 rounded-2xl p-6 flex flex-col hover:border-indigo-300 transition-colors">
            <div class="flex items-center gap-2 mb-3">
              <span
                class={`text-[11px] font-semibold px-2 py-0.5 rounded-full ${ownerColors[skill.owner] || "bg-slate-100 text-slate-600"}`}>
                {skill.owner}
              </span>
              {skill.version && (
                <span class="text-[11px] font-mono text-slate-400">
                  v{skill.version}
                </span>
              )}
            </div>
            <h3 class="font-semibold text-lg text-slate-800 mb-2">
              <a href={`/skills/${skill.id}`} class="hover:text-indigo-600">
                {skill.label}
              </a>
            </h3>
            <p class="text-slate-500 text-sm leading-relaxed flex-grow line-clamp-4">
              {skill.description}
            </p>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-5 text-sm">
              <a
                href={`/skills/${skill.id}`}
                class="font-medium text-indigo-600 hover:underline">
                View →
              </a>
              <a
                href={`/skills/${skill.id}/SKILL.md`}
                class="text-slate-500 hover:text-slate-800 font-mono text-xs">
                SKILL.md
              </a>
              {skill.repo && (
                <a
                  href={skill.repo}
                  target="_blank"
                  rel="noopener"
                  class="text-slate-500 hover:text-slate-800 text-xs">
                  Source ↗
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</Layout>
